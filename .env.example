# ====================================================
# Fishing Booking System - Environment Variables Template
# ====================================================

# Supabase PostgreSQL Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_KEY=your-supabase-anon-key

# Brevo (Sendinblue) Transactional Email Dispatch
VITE_BREVO_API_KEY=xkeysib-your-brevo-api-key
VITE_BREVO_SENDER_EMAIL=your-verified-sender@example.com
VITE_BREVO_SENDER_NAME="Scottish Highland Fishery"

# Server Proxy Configuration (Optional - for server/proxy.js)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_PROXY_TOKEN=your-optional-bearer-auth-token
PORT=3001